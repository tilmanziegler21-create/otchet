# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram ID администраторов через запятую (узнать можно у @userinfobot)
ADMIN_IDS=111111111,222222222

# Необязательные настройки
DB_PATH=bot.db
CURRENCY=€
# Час суточного бэкапа базы админам, 0-23 по времени сервера
BACKUP_HOUR=3
# Часовой пояс сервера: от него зависят «сегодня» в отчете и час бэкапа
TZ=Europe/Berlin
